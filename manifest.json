{
   "action": {
      "default_icon": {
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png",
         "128": "icons/icon.png"
      },
      "default_popup": "popup.html",
      "default_title": "WB Bhumi Receipt"
   },
   "background": {
      "service_worker": "eventPage/eventPage.js"
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "api-config.js", "content/content.js", "main/mainone.js" ],
      "matches": [ "https://banglarbhumi.gov.in/*" , "http://banglarbhumi.gov.in/*" ],
      "run_at": "document_idle"
   } ],
   "description": "Instant print of West Bengal Plot and Khatian. Print Khatian (খতিয়ান) & Plot (দাগ) details effortlessly.",
   "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "WB Bhumi Receipt",
   "permissions": [ "scripting", "activeTab", "notifications" ],
   "host_permissions": [ "http://banglarbhumi.gov.in/*", "https://banglarbhumi.gov.in/*", "https://wbbhumiprint.com/*" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.4"
}